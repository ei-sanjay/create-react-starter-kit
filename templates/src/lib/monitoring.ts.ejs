<% if (errorTracking === 'sentry') { -%>
import * as Sentry from '@sentry/react';

export function initMonitoring() {
<% if (buildTool === 'parcel') { -%>
  const dsn = process.env.VITE_SENTRY_DSN;
<% } else { -%>
  const dsn = import.meta.env.VITE_SENTRY_DSN;
<% } -%>
  if (!dsn) {
    return;
  }

  Sentry.init({
    dsn,
    tracesSampleRate: 0.1,
<% if (buildTool === 'parcel') { -%>
    environment: process.env.NODE_ENV || 'development',
<% } else { -%>
    environment: import.meta.env.MODE || 'development',
<% } -%>
  });
}
<% } else if (errorTracking === 'bugsnag') { -%>
import Bugsnag from '@bugsnag/js';
import BugsnagPluginReact from '@bugsnag/plugin-react';

export function initMonitoring() {
<% if (buildTool === 'parcel') { -%>
  const apiKey = process.env.VITE_BUGSNAG_API_KEY;
<% } else { -%>
  const apiKey = import.meta.env.VITE_BUGSNAG_API_KEY;
<% } -%>
  if (!apiKey) {
    return;
  }

  Bugsnag.start({
    apiKey,
    plugins: [new BugsnagPluginReact()],
  });
}
<% } else if (errorTracking === 'logrocket') { -%>
import LogRocket from 'logrocket';

export function initMonitoring() {
<% if (buildTool === 'parcel') { -%>
  const appId = process.env.VITE_LOGROCKET_APP_ID;
<% } else { -%>
  const appId = import.meta.env.VITE_LOGROCKET_APP_ID;
<% } -%>
  if (!appId) {
    return;
  }

  LogRocket.init(appId);
}
<% } else if (errorTracking === 'datadog') { -%>
import { datadogRum } from '@datadog/browser-rum';

export function initMonitoring() {
<% if (buildTool === 'parcel') { -%>
  const applicationId = process.env.VITE_DATADOG_APPLICATION_ID;
  const clientToken = process.env.VITE_DATADOG_CLIENT_TOKEN;
  const site = process.env.VITE_DATADOG_SITE || 'datadoghq.com';
<% } else { -%>
  const applicationId = import.meta.env.VITE_DATADOG_APPLICATION_ID;
  const clientToken = import.meta.env.VITE_DATADOG_CLIENT_TOKEN;
  const site = import.meta.env.VITE_DATADOG_SITE || 'datadoghq.com';
<% } -%>
  if (!applicationId || !clientToken) {
    return;
  }

  datadogRum.init({
    applicationId,
    clientToken,
    site,
    service: '<%= projectName %>',
    sessionSampleRate: 100,
    trackResources: true,
    trackLongTasks: true,
  });
}
<% } else { -%>
export function initMonitoring() {
  // Error tracking disabled for this scaffold.
}
<% } -%>
