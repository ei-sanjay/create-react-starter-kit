<% if (isTypeScript) { -%>
/**
 * Central place for reading public env vars.
<% if (buildTool === 'parcel') { -%>
 * Parcel injects values from `.env` via `process.env.*` at build time.
<% } else { -%>
 * Injected by Vite natively, by Rsbuild via `loadEnv` + `source.define`,
 * or by webpack DefinePlugin as `import.meta.env`.
<% } -%>
 */
export const env = {
  apiBaseUrl:
<% if (buildTool === 'parcel') { -%>
    process.env.VITE_API_BASE_URL || 'https://jsonplaceholder.typicode.com',
  mode: process.env.NODE_ENV || 'development',
<% } else { -%>
    import.meta.env.VITE_API_BASE_URL || 'https://jsonplaceholder.typicode.com',
  mode: import.meta.env.MODE || 'development',
<% } -%>
} as const;
<% } else { -%>
/** Central place for reading public env vars. */
export const env = {
  apiBaseUrl:
<% if (buildTool === 'parcel') { -%>
    process.env.VITE_API_BASE_URL || 'https://jsonplaceholder.typicode.com',
  mode: process.env.NODE_ENV || 'development',
<% } else { -%>
    import.meta.env.VITE_API_BASE_URL || 'https://jsonplaceholder.typicode.com',
  mode: import.meta.env.MODE || 'development',
<% } -%>
};
<% } -%>
