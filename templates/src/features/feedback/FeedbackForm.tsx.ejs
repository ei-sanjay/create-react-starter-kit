import { useState<% if (forms === 'none' && isTypeScript) { %>, type FormEvent<% } %> } from 'react';
<% if (forms === 'react-hook-form') { -%>
import { useForm } from 'react-hook-form';
<% if (validation === 'zod') { -%>
import { zodResolver } from '@hookform/resolvers/zod';
import { feedbackSchema<% if (isTypeScript) { %>, type FeedbackValues<% } %> } from '@/lib/validation';
<% } else if (validation === 'yup') { -%>
import { yupResolver } from '@hookform/resolvers/yup';
import { feedbackSchema<% if (isTypeScript) { %>, type FeedbackValues<% } %> } from '@/lib/validation';
<% } else if (validation === 'valibot') { -%>
import { valibotResolver } from '@hookform/resolvers/valibot';
import { feedbackSchema<% if (isTypeScript) { %>, type FeedbackValues<% } %> } from '@/lib/validation';
<% } else if (validation === 'joi') { -%>
import { joiResolver } from '@hookform/resolvers/joi';
import { feedbackSchema<% if (isTypeScript) { %>, type FeedbackValues<% } %> } from '@/lib/validation';
<% } else { -%>
import { validateFeedback<% if (isTypeScript) { %>, type FeedbackValues<% } %> } from '@/lib/validation';
<% } -%>
<% } else if (forms === 'formik') { -%>
import { Formik, Form, Field, ErrorMessage } from 'formik';
<% if (validation === 'none') { -%>
import { validateFeedback<% if (isTypeScript) { %>, type FeedbackValues<% } %> } from '@/lib/validation';
<% } else { -%>
<% if (validation === 'valibot') { -%>
import * as v from 'valibot';
<% } -%>
import { feedbackSchema<% if (isTypeScript) { %>, type FeedbackValues<% } %> } from '@/lib/validation';
<% } -%>
<% } else if (forms === 'tanstack-form') { -%>
import { useForm } from '@tanstack/react-form';
<% if (validation === 'valibot') { -%>
import * as v from 'valibot';
<% } -%>
<% if (validation !== 'none') { -%>
import { feedbackSchema } from '@/lib/validation';
<% } -%>
<% if (isTypeScript) { -%>
import type { FeedbackValues } from '@/lib/validation';
<% } -%>
<% } else { -%>
<% if (validation === 'none') { -%>
import { validateFeedback<% if (isTypeScript) { %>, type FeedbackValues<% } %> } from '@/lib/validation';
<% } else { -%>
import { feedbackSchema<% if (isTypeScript) { %>, type FeedbackValues<% } %> } from '@/lib/validation';
<% } -%>
<% } -%>
<% if (serverState === 'rtk-query') { -%>
import { useCreateFeedbackMutation } from '@/store/postsApi';
<% } else { -%>
import { createFeedback } from '@/services/api';
<% } -%>
import { UiButton } from '@/components/ui/UiButton';

const defaults<% if (isTypeScript) { %>: FeedbackValues<% } %> = {
  name: '',
  email: '',
  message: '',
};

export function FeedbackForm() {
  const [status, setStatus] = useState<% if (isTypeScript) { %><string | null><% } %>(null);
<% if (serverState === 'rtk-query') { -%>
  const [createFeedbackMutation] = useCreateFeedbackMutation();
  const createFeedback = async (values<% if (isTypeScript) { %>: FeedbackValues<% } %>) => {
    await createFeedbackMutation(values).unwrap();
  };
<% } -%>

<% if (forms === 'react-hook-form') { -%>
  const {
    register,
    handleSubmit,
    reset,
<% if (validation === 'none') { -%>
    setError,
<% } -%>
    formState: { errors, isSubmitting },
  } = useForm<% if (isTypeScript) { %><FeedbackValues><% } %>({
    defaultValues: defaults,
<% if (validation === 'zod') { -%>
    resolver: zodResolver(feedbackSchema),
<% } else if (validation === 'yup') { -%>
    resolver: yupResolver(feedbackSchema),
<% } else if (validation === 'valibot') { -%>
    resolver: valibotResolver(feedbackSchema),
<% } else if (validation === 'joi') { -%>
    resolver: joiResolver(feedbackSchema),
<% } -%>
  });

  const onSubmit = async (values<% if (isTypeScript) { %>: FeedbackValues<% } %>) => {
<% if (validation === 'none') { -%>
    const nextErrors = validateFeedback(values);
    const keys = Object.keys(nextErrors);
    if (keys.length) {
      keys.forEach((key) => {
        const message = nextErrors[<% if (isTypeScript) { %>key as keyof FeedbackValues<% } else { %>key<% } %>];
        if (message) {
          setError(<% if (isTypeScript) { %>key as keyof FeedbackValues<% } else { %>key<% } %>, { type: 'manual', message });
        }
      });
      return;
    }
<% } -%>
    await createFeedback(values);
    setStatus('Feedback submitted successfully (demo API).');
    reset();
  };

  return (
    <article className="panel">
      <header className="panel-header">
        <h2>Forms & validation</h2>
        <p>
          <%= stackLabels.forms %>
<% if (validation !== 'none') { -%>
          {' '}
          + <%= stackLabels.validation %>
<% } -%>
        </p>
      </header>
      <form className="feedback-form" onSubmit={handleSubmit(onSubmit)} noValidate>
        <label>
          Name
          <input {...register('name')} placeholder="Ada Lovelace" />
          {errors.name && <span className="field-error">{errors.name.message}</span>}
        </label>
        <label>
          Email
          <input type="email" {...register('email')} placeholder="ada@example.com" />
          {errors.email && <span className="field-error">{errors.email.message}</span>}
        </label>
        <label>
          Message
          <textarea rows={4} {...register('message')} placeholder="What should we improve?" />
          {errors.message && <span className="field-error">{errors.message.message}</span>}
        </label>
        <UiButton type="submit" disabled={isSubmitting} data-testid="feedback-submit">
          {isSubmitting ? 'Sending…' : 'Send feedback'}
        </UiButton>
      </form>
      {status && (
        <p className="success-text" aria-live="polite" data-testid="feedback-success">
          {status}
        </p>
      )}
      <p className="panel-note">
        <strong>When to use:</strong> complex forms with validation and async submit.
        <br />
        <strong>Best practice:</strong> keep schemas in <code>src/lib</code> and reuse across client/server.
      </p>
    </article>
  );
<% } else if (forms === 'formik') { -%>
  return (
    <article className="panel">
      <header className="panel-header">
        <h2>Forms & validation</h2>
        <p>
          <%= stackLabels.forms %>
<% if (validation !== 'none') { -%>
          {' '}
          + <%= stackLabels.validation %>
<% } -%>
        </p>
      </header>
      <Formik
        initialValues={defaults}
<% if (validation === 'yup') { -%>
        validationSchema={feedbackSchema}
<% } else if (validation === 'zod') { -%>
        validate={(values) => {
          const parsed = feedbackSchema.safeParse(values);
          if (parsed.success) {
            return {};
          }
          return Object.fromEntries(
            parsed.error.issues.map((issue) => [String(issue.path[0]), issue.message]),
          );
        }}
<% } else if (validation === 'valibot') { -%>
        validate={(values) => {
          const parsed = v.safeParse(feedbackSchema, values);
          if (parsed.success) {
            return {};
          }
          return Object.fromEntries(
            parsed.issues.map((issue) => {
              const segment = issue.path?.[0];
              const key =
                segment && typeof segment === 'object' && 'key' in segment
                  ? String(segment.key)
                  : 'name';
              return [key, issue.message];
            }),
          );
        }}
<% } else if (validation === 'joi') { -%>
        validate={(values) => {
          const result = feedbackSchema.validate(values, { abortEarly: false });
          if (!result.error) {
            return {};
          }
          return Object.fromEntries(
            result.error.details.map((d<% if (isTypeScript) { %>: { path: (string | number)[]; message: string }<% } %>) => [
              String(d.path[0]),
              d.message,
            ]),
          );
        }}
<% } else { -%>
        validate={(values) => validateFeedback(values)}
<% } -%>
        onSubmit={async (values, helpers) => {
          await createFeedback(values);
          setStatus('Feedback submitted successfully (demo API).');
          helpers.resetForm();
        }}
      >
        {({ isSubmitting }) => (
          <Form className="feedback-form" noValidate>
            <label>
              Name
              <Field name="name" placeholder="Ada Lovelace" />
              <ErrorMessage name="name" component="span" className="field-error" />
            </label>
            <label>
              Email
              <Field name="email" type="email" placeholder="ada@example.com" />
              <ErrorMessage name="email" component="span" className="field-error" />
            </label>
            <label>
              Message
              <Field as="textarea" rows={4} name="message" placeholder="What should we improve?" />
              <ErrorMessage name="message" component="span" className="field-error" />
            </label>
            <UiButton type="submit" disabled={isSubmitting} data-testid="feedback-submit">
              {isSubmitting ? 'Sending…' : 'Send feedback'}
            </UiButton>
          </Form>
        )}
      </Formik>
      {status && (
        <p className="success-text" aria-live="polite" data-testid="feedback-success">
          {status}
        </p>
      )}
      <p className="panel-note">
        <strong>When to use:</strong> form-heavy screens with the Formik render/props model.
        <br />
        <strong>Best practice:</strong> prefer Yup/Zod schemas over ad-hoc validators.
      </p>
    </article>
  );
<% } else if (forms === 'tanstack-form') { -%>
  const [submitErrors, setSubmitErrors] = useState<% if (isTypeScript) { %><Partial<Record<keyof FeedbackValues, string>>><% } else { %><Record<string, string>><% } %>({});
  const form = useForm({
    defaultValues: defaults,
    onSubmit: async ({ value }) => {
      const nextErrors<% if (isTypeScript) { %>: Partial<Record<keyof FeedbackValues, string>><% } %> = {};
<% if (validation === 'zod') { -%>
      const parsed = feedbackSchema.safeParse(value);
      if (!parsed.success) {
        parsed.error.issues.forEach((issue) => {
          nextErrors[<% if (isTypeScript) { %>String(issue.path[0]) as keyof FeedbackValues<% } else { %>String(issue.path[0])<% } %>] = issue.message;
        });
      }
<% } else if (validation === 'yup') { -%>
      try {
        await feedbackSchema.validate(value, { abortEarly: false });
      } catch (err) {
        if (err && typeof err === 'object' && 'inner' in err) {
          (err<% if (isTypeScript) { %> as { inner: Array<{ path?: string; message: string }> }<% } %>).inner.forEach((e) => {
            if (e.path) {
              nextErrors[<% if (isTypeScript) { %>e.path as keyof FeedbackValues<% } else { %>e.path<% } %>] = e.message;
            }
          });
        }
      }
<% } else if (validation === 'valibot') { -%>
      const parsed = v.safeParse(feedbackSchema, value);
      if (!parsed.success) {
        parsed.issues.forEach((issue) => {
          const segment = issue.path?.[0];
          const key =
            segment && typeof segment === 'object' && 'key' in segment
              ? String(segment.key)
              : 'name';
          nextErrors[<% if (isTypeScript) { %>key as keyof FeedbackValues<% } else { %>key<% } %>] = issue.message;
        });
      }
<% } else if (validation === 'joi') { -%>
      const result = feedbackSchema.validate(value, { abortEarly: false });
      if (result.error) {
        result.error.details.forEach((d<% if (isTypeScript) { %>: { path: (string | number)[]; message: string }<% } %>) => {
          nextErrors[<% if (isTypeScript) { %>String(d.path[0]) as keyof FeedbackValues<% } else { %>String(d.path[0])<% } %>] =
            d.message;
        });
      }
<% } else if (validation === 'none') { -%>
      if (!value.name || value.name.length < 2) nextErrors.name = 'Name must be at least 2 characters';
      if (!value.email || !value.email.includes('@')) nextErrors.email = 'Enter a valid email';
      if (!value.message || value.message.length < 10) nextErrors.message = 'Message must be at least 10 characters';
<% } -%>
      setSubmitErrors(nextErrors);
      if (Object.keys(nextErrors).length) {
        return;
      }
      await createFeedback(value);
      setStatus('Feedback submitted successfully (demo API).');
      form.reset();
    },
  });

  return (
    <article className="panel">
      <header className="panel-header">
        <h2>Forms & validation</h2>
        <p>
          <%= stackLabels.forms %>
<% if (validation !== 'none') { -%>
          {' '}
          + <%= stackLabels.validation %>
<% } -%>
        </p>
      </header>
      <form
        className="feedback-form"
        noValidate
        onSubmit={(e) => {
          e.preventDefault();
          e.stopPropagation();
          void form.handleSubmit();
        }}
      >
        <form.Field name="name">
          {(field) => (
            <label>
              Name
              <input
                value={field.state.value}
                onBlur={field.handleBlur}
                onChange={(e) => field.handleChange(e.target.value)}
                placeholder="Ada Lovelace"
              />
              {submitErrors.name && <span className="field-error">{submitErrors.name}</span>}
            </label>
          )}
        </form.Field>
        <form.Field name="email">
          {(field) => (
            <label>
              Email
              <input
                type="email"
                value={field.state.value}
                onBlur={field.handleBlur}
                onChange={(e) => field.handleChange(e.target.value)}
                placeholder="ada@example.com"
              />
              {submitErrors.email && <span className="field-error">{submitErrors.email}</span>}
            </label>
          )}
        </form.Field>
        <form.Field name="message">
          {(field) => (
            <label>
              Message
              <textarea
                rows={4}
                value={field.state.value}
                onBlur={field.handleBlur}
                onChange={(e) => field.handleChange(e.target.value)}
                placeholder="What should we improve?"
              />
              {submitErrors.message && <span className="field-error">{submitErrors.message}</span>}
            </label>
          )}
        </form.Field>
        <UiButton type="submit" data-testid="feedback-submit">Send feedback</UiButton>
      </form>
      {status && (
        <p className="success-text" aria-live="polite" data-testid="feedback-success">
          {status}
        </p>
      )}
      <p className="panel-note">
        <strong>When to use:</strong> headless, type-safe forms with fine-grained reactivity.
        <br />
        <strong>Best practice:</strong> validate at field and form boundaries with a shared schema.
      </p>
    </article>
  );
<% } else { -%>
  const [values, setValues] = useState<% if (isTypeScript) { %><FeedbackValues><% } %>(defaults);
  const [errors, setErrors] = useState<% if (isTypeScript) { %><Partial<Record<keyof FeedbackValues, string>>><% } %>({});
  const [isSubmitting, setIsSubmitting] = useState(false);

  const onSubmit = async (event<% if (isTypeScript) { %>: FormEvent<% } %>) => {
    event.preventDefault();
<% if (validation === 'none') { -%>
    const nextErrors = validateFeedback(values);
<% } else if (validation === 'zod') { -%>
    const parsed = feedbackSchema.safeParse(values);
    const nextErrors = parsed.success
      ? {}
      : Object.fromEntries(
          parsed.error.issues.map((issue) => [String(issue.path[0]), issue.message]),
        );
<% } else if (validation === 'yup') { -%>
    let nextErrors<% if (isTypeScript) { %>: Partial<Record<keyof FeedbackValues, string>><% } %> = {};
    try {
      await feedbackSchema.validate(values, { abortEarly: false });
    } catch (err) {
      if (err && typeof err === 'object' && 'inner' in err) {
        nextErrors = Object.fromEntries(
          (err<% if (isTypeScript) { %> as { inner: Array<{ path?: string; message: string }> }<% } %>).inner
            .filter((e) => e.path)
            .map((e) => [e.path, e.message]),
        );
      }
    }
<% } else if (validation === 'joi') { -%>
    const result = feedbackSchema.validate(values, { abortEarly: false });
    const nextErrors = result.error
      ? Object.fromEntries(
          result.error.details.map((d<% if (isTypeScript) { %>: { path: (string | number)[]; message: string }<% } %>) => [
            String(d.path[0]),
            d.message,
          ]),
        )
      : {};
<% } else { -%>
    let nextErrors<% if (isTypeScript) { %>: Partial<Record<keyof FeedbackValues, string>><% } %> = {};
    try {
      const { parse } = await import('valibot');
      parse(feedbackSchema, values);
    } catch (err) {
      nextErrors = { message: err instanceof Error ? err.message : 'Invalid form' };
    }
<% } -%>
    setErrors(nextErrors);
    if (Object.keys(nextErrors).length) return;
    setIsSubmitting(true);
    try {
      await createFeedback(values);
      setStatus('Feedback submitted successfully (demo API).');
      setValues(defaults);
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <article className="panel">
      <header className="panel-header">
        <h2>Forms & validation</h2>
        <p>Native form controls<% if (validation !== 'none') { %> + <%= stackLabels.validation %><% } %></p>
      </header>
      <form className="feedback-form" onSubmit={onSubmit} noValidate>
        <label>
          Name
          <input
            value={values.name}
            onChange={(e) => setValues((v) => ({ ...v, name: e.target.value }))}
            placeholder="Ada Lovelace"
          />
          {errors.name && <span className="field-error">{errors.name}</span>}
        </label>
        <label>
          Email
          <input
            type="email"
            value={values.email}
            onChange={(e) => setValues((v) => ({ ...v, email: e.target.value }))}
            placeholder="ada@example.com"
          />
          {errors.email && <span className="field-error">{errors.email}</span>}
        </label>
        <label>
          Message
          <textarea
            rows={4}
            value={values.message}
            onChange={(e) => setValues((v) => ({ ...v, message: e.target.value }))}
            placeholder="What should we improve?"
          />
          {errors.message && <span className="field-error">{errors.message}</span>}
        </label>
        <UiButton type="submit" disabled={isSubmitting} data-testid="feedback-submit">
          {isSubmitting ? 'Sending…' : 'Send feedback'}
        </UiButton>
      </form>
      {status && (
        <p className="success-text" aria-live="polite" data-testid="feedback-success">
          {status}
        </p>
      )}
      <p className="panel-note">
        <strong>When to use:</strong> simple forms without a dedicated form library.
        <br />
        <strong>Best practice:</strong> graduate to a form library once fields or validation grow.
      </p>
    </article>
  );
<% } -%>
}
