<%
  const unknownAtRules = [];
  if (styling === 'tailwind' || uiLibrary === 'shadcn') {
    unknownAtRules.push('tailwind', 'apply');
  }
  if (styling === 'sass') {
    unknownAtRules.push(
      'use',
      'forward',
      'mixin',
      'include',
      'function',
      'extend',
      'error',
      'warn',
      'debug',
      'at-root',
      'each',
      'for',
      'if',
      'else',
      'while',
      'content',
      'return',
    );
  }
-%>
{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/storybook-static",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.husky",
      "!**/public"
    ]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:", ":BUN:", ":PACKAGE_WITH_PROTOCOL:", ":PACKAGE:"],
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:", "!:STYLE:"],
              ":BLANK_LINE:",
              [":STYLE:"]
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"<% if (unknownAtRules.length) { %>,
      "suspicious": {
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": <%- JSON.stringify(unknownAtRules) %>
          }
        }
      }<% } %>
    },
    "domains": {
      "react": "recommended",
      "test": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": <%= styling === 'tailwind' || uiLibrary === 'shadcn' %>,
      "cssModules": <%= styling === 'css-modules' %>
    }
  },
  "overrides": [
    {
      "includes": ["package.json"],
      "json": {
        "formatter": {
          "expand": "auto"
        }
      }
    }
  ]
}
