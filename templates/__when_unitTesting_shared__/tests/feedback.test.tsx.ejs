  const actual = await importOriginal<% if (isTypeScript) { %><typeof import('@/store/postsApi')><% } %>();
  return {
    ...actual,
    useCreateFeedbackMutation: () => [
      vi.fn(() => ({
        unwrap: vi.fn(async () => ({ id: 101 })),
      })),
      { isLoading: false },
    ],
  };
});
<% } else { -%>
jest.mock('@/store/postsApi', () => {
  const actual = jest.requireActual('@/store/postsApi')<% if (isTypeScript) { %> as typeof import('@/store/postsApi')<% } %>;
  return {
    ...actual,
    useCreateFeedbackMutation: () => [
      jest.fn(() => ({
        unwrap: jest.fn(async () => ({ id: 101 })),
      })),
      { isLoading: false },
    ],
  };
});
<% } -%>
<% } else { -%>
<% if (unitTesting === 'vitest') { -%>
vi.mock('@/services/api', async (importOriginal) => {
  const actual = await importOriginal<% if (isTypeScript) { %><typeof import('@/services/api')><% } %>();
  return {
    ...actual,
    createFeedback: vi.fn(async () => ({ id: 101 })),
  };
});
<% } else { -%>
jest.mock('@/services/api', () => {
  const actual = jest.requireActual('@/services/api')<% if (isTypeScript) { %> as typeof import('@/services/api')<% } %>;
  return {
    ...actual,
    createFeedback: jest.fn(async () => ({ id: 101 })),
  };
});
<% } -%>
