<% if (linting === 'biome') { -%>
const biome =
  'biome check --write --files-ignore-unknown=true --no-errors-on-unmatched';

export default {
  'src/**/*.{ts,tsx,css,scss}': biome,
  'tests/**/*.{ts,tsx}': biome,
  'docs/**/*.md': biome,
  '*.{json,md}': biome,
};
<% } else { -%>
const eslintFix = ['eslint --fix', 'prettier --write'];

export default {
  'src/**/*.{ts,tsx}': eslintFix,
  'tests/**/*.{ts,tsx}': eslintFix,
  'src/**/*.{css,scss,md,json}': 'prettier --write',
  'docs/**/*.md': 'prettier --write',
<% if (visualTesting === 'storybook') { -%>
  '.storybook/**/*.{js,cjs,mjs,ts,tsx}': eslintFix,
<% } -%>
<% if (e2eTesting === 'cypress') { -%>
  'cypress/**/*.{ts,tsx}': eslintFix,
<% } -%>
  '*.{json,md}': 'prettier --write',
};
<% } -%>
