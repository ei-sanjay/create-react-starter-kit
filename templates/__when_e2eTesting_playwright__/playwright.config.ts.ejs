import { defineConfig, devices } from '@playwright/test';

/**
 * Run once before first e2e: `<%= packageManager === 'npm' ? 'npm run' : packageManager %> test:e2e:install`
 *
 * Default ports (keep in sync with the app bundler config):
 * - Vite → 5173
 * - Webpack → 3000
 * - Rsbuild → 8080
 *
 * Locally, reuse an already-running server on the matching port (same as previous
 * working behavior). In CI always start a fresh server.
 * Bundlers use host 127.0.0.1 + strictPort so Playwright never waits forever on
 * a different auto-picked port.
 */
<% const e2ePort = buildTool === 'webpack' ? 3000 : buildTool === 'rsbuild' ? 8080 : 5173; -%>
<% const webServerCommand =
  buildTool === 'webpack'
    ? 'npx webpack serve --mode development --host 127.0.0.1 --port 3000'
    : buildTool === 'rsbuild'
      ? 'npx rsbuild dev --host 127.0.0.1 --port 8080'
      : 'npx vite --host 127.0.0.1 --port 5173 --strictPort';
-%>
export default defineConfig({
  testDir: './tests/e2e',
  fullyParallel: true,
  forbidOnly: !!process.env.CI,
  retries: process.env.CI ? 1 : 0,
  reporter: process.env.CI ? 'github' : 'list',
  use: {
    baseURL: 'http://127.0.0.1:<%= e2ePort %>',
    trace: 'on-first-retry',
    screenshot: 'only-on-failure',
  },
  webServer: {
    command: '<%= webServerCommand %>',
    url: 'http://127.0.0.1:<%= e2ePort %>',
    reuseExistingServer: !process.env.CI,
    timeout: 120_000,
  },
  projects: [{ name: 'chromium', use: { ...devices['Desktop Chrome'] } }],
});
